[flake8]
# Align with black (pyproject.toml line-length = 88) so the pre-commit
# flake8 hook and black/isort do not conflict.
max-line-length = 88
# E501 is owned by black; black deliberately leaves comments/string literals it
# cannot wrap, so flake8 must not re-litigate line length in a black repo.
extend-ignore = E203, E704, W503, E501
# Standalone scripts intentionally insert sys.path before importing project
# modules, which trips E402; that pattern is correct for entry-point scripts.
per-file-ignores =
    scripts/*:E402
exclude =
    .git,
    .venv,
    __pycache__,
    .streamlit,
